<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bgregiscoksu"
    android:gravity="center_horizontal"
    tools:context=".LoginActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Selamat Datang,"
        android:textColor="#000000"
        android:textSize="18sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sahabat Finly!!"
        android:textStyle="bold"
        android:textColor="#0066FF"
        android:textSize="20sp"
        android:layout_marginBottom="16dp"/>

    <ImageView
        android:id="@+id/ivIllustration"
        android:layout_width="305dp"
        android:layout_height="280dp"
        android:src="@drawable/bgregis"
        android:scaleType="fitCenter"
        android:layout_marginBottom="24dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="60dp"
        android:orientation="vertical">

        <EditText
            android:id="@+id/emailEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Email"
            android:drawableStart="@drawable/email"
            android:background="@null"
            android:paddingVertical="12dp"
            android:drawablePadding="12dp"
            android:inputType="textEmailAddress" />

        <View android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#888888" />

        <EditText
            android:id="@+id/passwordEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Kata Sandi"
            android:drawableStart="@drawable/password"
            android:background="@null"
            android:paddingVertical="12dp"
            android:drawablePadding="12dp"
            android:inputType="textPassword" />

        <View android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#888888" />

    </LinearLayout>

    <Button
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:text="Login"
        android:id="@+id/btnLogin"
        android:textStyle="bold"
        android:backgroundTint="#006BFF"
        android:background="@drawable/bg_regis"
        android:textColor="@android:color/white"
        android:layout_marginBottom="15dp"
        android:layout_marginHorizontal="60dp"
        android:layout_marginTop="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Belum Punya Akun? "
        android:textColor="#000000"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvRegis"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Register"
        android:textColor="#0066FF"
        android:textSize="14sp"
        android:layout_marginBottom="3dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="9dp">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/gicon"
            android:layout_margin="8dp" />

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/facebook"
            android:layout_margin="8dp" />

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/apel"
            android:layout_margin="8dp" />
    </LinearLayout>

</LinearLayout>