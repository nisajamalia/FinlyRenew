<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".DokumenFragment"
    android:background="@color/blue"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Document Items -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_document_item"
            android:padding="16dp"
            android:layout_marginBottom="8dp">

            <!-- KTP Photo Preview -->
            <ImageView
                android:id="@+id/ktpPreview"
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:src="@drawable/ktp_default" />

            <!-- Upload Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/uploadKtpButton"
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Foto KTP"
                app:backgroundTint="@color/blue_dark"
                android:textColor="@color/white"
                app:cornerRadius="16dp"
                android:textAllCaps="false"/>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="73dp">

                <!-- Camera Preview -->
                <TextureView
                    android:id="@+id/textureView"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="16dp" />

                <TextView
                    android:id="@+id/titleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:layout_marginTop="27dp"
                    android:text="Selfie dengan KTP"
                    android:textColor="@android:color/black"
                    android:textSize="16sp" />

                <ImageButton
                    android:id="@+id/captureButton"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_alignParentRight="true"
                    android:layout_marginTop="16dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:scaleType="fitCenter"
                    android:src="@drawable/camera_icon" />

            </RelativeLayout>

            <EditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="NPWP"
                android:textColorHint="#80000000"                android:textSize="16sp"
                android:textColor="#000000" />
        </LinearLayout>

        <!-- Inside your Surat Pernyataan section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_document_item"
            android:padding="16dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Surat Pernyataan tanggung jawab pribadi"
                android:textSize="16sp"
                android:textColor="#000000"
                android:layout_marginBottom="8dp"/>

            <!-- Add this TextView to show the filename -->
            <TextView
                android:id="@+id/documentFileNameText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No file selected"
                android:textSize="14sp"
                android:textColor="#666666"
                android:layout_marginBottom="8dp"
                android:visibility="gone"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/uploadSuratPernyataanButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Upload Surat Pernyataan"
                app:backgroundTint="@color/blue_dark"
                android:textColor="@color/white"
                app:cornerRadius="16dp"
                android:textAllCaps="false"/>
        </LinearLayout>

        <!-- Proposal Usaha Section -->
        <LinearLayout
            android:layout_marginBottom="60dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_document_item"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Proposal Usaha"
                android:textSize="16sp"
                android:textColor="#000000"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/proposalFileNameText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No file selected"
                android:textSize="14sp"
                android:textColor="#666666"
                android:layout_marginBottom="8dp"
                android:visibility="gone"/>

            <com.google.android.material.button.MaterialButton
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:backgroundTint="@color/blue_dark"
                android:textColor="@color/white"
                app:cornerRadius="16dp"
                android:textAllCaps="false"
                android:text="Upload Proposal Usaha"
                android:id="@+id/uploadProposalButton"
                />
        </LinearLayout>

    </LinearLayout>
</ScrollView>