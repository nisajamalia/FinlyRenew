<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/registerScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bgregiscoksu"
    tools:context=".RegisterActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Selamat Datang,"
            android:textColor="#000000"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sahabat Finly!!"
            android:textStyle="bold"
            android:textColor="#0066FF"
            android:textSize="20sp"
            android:layout_marginBottom="16dp"/>

        <ImageView
            android:id="@+id/ivIllustration"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:src="@drawable/bgregis"
            android:scaleType="fitCenter"
            android:layout_marginBottom="24dp"/>

        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nama Lengkap"
            android:drawableStart="@drawable/user"
            android:background="@null"
            android:paddingVertical="12dp"
            android:drawablePadding="12dp"
            android:inputType="textPersonName" />

        <View android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#888888" />


        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Email"
            android:drawableStart="@drawable/email"
            android:background="@null"
            android:paddingVertical="12dp"
            android:drawablePadding="12dp"
            android:inputType="textEmailAddress" />

        <View android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#888888" />

        <!-- Nomor Telepon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🇮🇩 +62"
                android:textSize="16sp"
                android:layout_marginEnd="8dp" />

            <EditText
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Nomor Telepon"
                android:background="@null"
                android:inputType="phone" />
        </LinearLayout>

        <View android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#888888" />

        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Kata Sandi"
            android:drawableStart="@drawable/password"
            android:background="@null"
            android:paddingVertical="12dp"
            android:drawablePadding="12dp"
            android:inputType="textPassword" />

        <View android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#888888" />

        <EditText
            android:id="@+id/yourTanggalLahirEditTextId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tanggal Lahir"
            android:drawableStart="@drawable/calender"
            android:background="@null"
            android:paddingVertical="12dp"
            android:drawablePadding="12dp"
            android:focusable="false" />

        <View android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#888888" />

        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Jenis Kelamin"
            android:drawableStart="@drawable/gender"
            android:background="@null"
            android:id="@+id/yourJenisKelaminEditTextId"
            android:paddingVertical="12dp"
            android:drawablePadding="12dp"
            android:focusable="false" />

        <View android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#888888" />

        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Pemasukan"
            android:drawableStart="@drawable/money"
            android:background="@null"
            android:paddingVertical="12dp"
            android:drawablePadding="12dp"
            android:inputType="numberDecimal" />

        <View android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#888888" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/yourRegisterButtonId"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Register"
            android:textStyle="bold"
            android:backgroundTint="#006BFF"
            android:background="#006BFF"
            android:textColor="@android:color/white"
            android:layout_marginBottom="15dp"
            android:layout_marginTop="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sudah punya akun? "
            android:textColor="#000000"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvMasuk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Masuk"
            android:textColor="#0066FF"
            android:textSize="14sp"
            android:layout_marginBottom="3dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="12dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/gicon"
                android:layout_margin="8dp" />

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/facebook"
                android:layout_margin="8dp" />

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/apel"
                android:layout_margin="8dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
